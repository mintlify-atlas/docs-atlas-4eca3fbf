  "keyFeatures": [
    "Subscription management with flexible billing intervals",
    "Usage-based billing with real-time metering",
    "Credit systems with top-ups and rollovers",
    "Multi-seat pricing with per-seat limits",
    "Free trials with automatic conversion",
    "Custom pricing for enterprise customers",
    "Webhook events for billing lifecycle",
    "Stripe integration for payment processing",
    "Customer portal for self-service management",
    "Analytics and usage insights"
  ],
  "publicApiSurface": [
    "POST /attach - Attach products to customers",
    "POST /check - Check feature access and remaining usage",
    "POST /track - Record usage events",
    "POST /checkout - Create checkout sessions",
    "POST /cancel - Cancel customer subscriptions",
    "POST /setup_payment - Setup payment methods",
    "GET /products - List all products",
    "POST /products - Create products",
    "GET /products/{product_id} - Get product details",
    "PATCH /products/{product_id} - Update products",
    "DELETE /products/{product_id} - Delete products",
    "GET /customers - List all customers",
    "POST /customers - Create customers",
    "GET /customers/{customer_id} - Get customer details",
    "PATCH /customers/{customer_id} - Update customers",
    "DELETE /customers/{customer_id} - Delete customers",
    "POST /customers/{customer_id}/billing_portal - Get billing portal URL",
    "GET /features - List all features",
    "POST /features - Create features",
    "GET /features/{feature_id} - Get feature details",
    "PATCH /features/{feature_id} - Update features",
    "DELETE /features/{feature_id} - Delete features",
    "GET /entities - List entities",
    "POST /entities - Create entities",
    "GET /entities/{entity_id} - Get entity details",
    "PATCH /entities/{entity_id} - Update entities",
    "DELETE /entities/{entity_id} - Delete entities",
    "GET /balances/list - List customer balances",
    "POST /balances/create - Create balance entries",
    "POST /balances/update - Update balances",
    "GET /invoices - List invoices",
    "GET /invoices/{invoice_id} - Get invoice details",
    "GET /events - List usage events"
  ]
}
