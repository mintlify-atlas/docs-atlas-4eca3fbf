  "keyFeatures": [
    "Flexible pricing models (subscriptions, usage-based, credits, seat-based)",
    "Stripe integration layer with simplified API",
    "Real-time usage tracking and access control",
    "Customer and entity management",
    "Automatic webhook handling",
    "Built-in analytics and reporting",
    "Self-hosted or cloud deployment",
    "Dashboard for managing products and customers"
  ],
  "publicApiSurface": [
    "POST /attach - Attach products to customers",
    "POST /check - Check feature access and balances",
    "POST /track - Track usage events",
    "POST /checkout - Create checkout sessions",
    "POST /cancel - Cancel product subscriptions",
    "POST /setup_payment - Setup payment methods",
    "POST /customers/{customer_id}/billing_portal - Create billing portal sessions",
    "GET /products - List products",
    "POST /products - Create products",
    "GET /products/{product_id} - Get product details",
    "PATCH /products/{product_id} - Update products",
    "DELETE /products/{product_id} - Delete products",
    "GET /features - List features",
    "POST /features - Create features",
    "GET /customers - List customers",
    "POST /customers - Create customers",
    "POST /balances/create - Create customer balances",
    "POST /balances/update - Update customer balances",
    "GET /events - List usage events",
    "POST /query - Query analytics data"
  ]
